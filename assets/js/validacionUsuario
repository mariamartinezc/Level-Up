function calculoEdad() {
    
    var fechaNac = document.getElementById("fechaNacimiento").value;
    
    if (!fechaNac) {
        return "Por favor ingresa una fecha.";
    }

    var hoy = new Date();
    var nacimiento = new Date(fechaNac);

    var anios = hoy.getFullYear() - nacimiento.getFullYear();
    var mes = hoy.getMonth() - nacimiento.getMonth();

    // Ajuste si aún no cumplió años este año
    if (mes < 0 || (mes === 0 && hoy.getDate() < nacimiento.getDate())) {
        anios--;
    }

    return anios;}

function esMayorDeEdad() {
    var edad = calculoEdad(); 

    if (edad === null) {
        alert("Por favor ingresa una fecha de nacimiento.");
        return false;
    }

    if (edad >= 18) {
        alert("Eres mayor de edad. Edad: " + edad);
        return true;
    } else {
        alert("No eres mayor de edad. Edad: " + edad);
        return false;
    }
}

